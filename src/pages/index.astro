---
import PostFeed from '../components/PostFeed.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHOR_NAME, HOME_LINKS, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { withBase } from '../utils/paths';
import { getPublishedPosts, paginatePosts } from '../utils/posts';

// 社交入口位于文章流之后，加载下一页时仍在列表末尾。
const [first] = paginatePosts(await getPublishedPosts());
const siteUrl = new URL(withBase('/'), Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_TITLE,
  url: siteUrl,
  description: SITE_DESCRIPTION,
  inLanguage: 'zh-CN',
  author: { '@type': 'Person', name: AUTHOR_NAME, url: new URL(withBase('/about/'), Astro.site).href },
};
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} jsonLd={jsonLd}>
  {
    first.posts.length > 0 ? (
      <PostFeed page={first} />
    ) : (
      <p class="empty-state">还没有发布文章，第一篇正在路上。</p>
    )
  }
  {
    HOME_LINKS.length > 0 && (
      <nav class="home-links" aria-label="社交账号">
        {HOME_LINKS.map((link, index) =>
          'qr' in link ? (
            <>
              {/* 二维码用浏览器自带的 popover：不用写脚本，点外面或按 Esc 关掉。 */}
              <button class="home-links-qr" type="button" popovertarget={`home-qr-${index}`}>
                {link.label}
              </button>
              <div class="qr-popover" id={`home-qr-${index}`} popover>
                <img src={withBase(link.qr)} alt={link.alt} width="600" height="870" loading="lazy" />
                <p class="qr-popover-hint">手机上：长按保存图片，再用微信扫一扫从相册识别。</p>
              </div>
            </>
          ) : (
            <a href={link.href}>{link.label}</a>
          ),
        )}
      </nav>
    )
  }
</BaseLayout>
