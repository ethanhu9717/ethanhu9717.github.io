---
import { render } from 'astro:content';
import Comments from '../../components/Comments.astro';
import CommentsPreconnect from '../../components/CommentsPreconnect.astro';
import PostRow from '../../components/PostRow.astro';
import TagList from '../../components/TagList.astro';
import ViewCount from '../../components/ViewCount.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AUTHOR_NAME } from '../../consts';
import { withBase } from '../../utils/paths';
import {
  fillWithLatest,
  formatDate,
  getBacklinks,
  getExcerpt,
  getPostUrl,
  getPublishedPosts,
  getReadingMinutes,
  getRelatedPosts,
  type Post,
} from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const backlinks = getBacklinks(posts);

  return posts.map((post) => {
    const related = getRelatedPosts(post, posts);
    return {
      params: { slug: post.id },
      props: {
        post,
        backlinks: backlinks.get(post.id) ?? [],
        related,
        more: fillWithLatest(post, related, posts),
      },
    };
  });
}

interface Props {
  post: Post;
  backlinks: Post[];
  /** 有共同标签的文章。 */
  related: Post[];
  /** related 不够 3 篇时用最新文章补齐。 */
  more: Post[];
}

const { post, backlinks, related, more } = Astro.props;
// 全是同标签的文章时叫「相关文章」，补了最新文章就叫「更多文章」。
const moreTitle = more.length === related.length ? '相关文章' : '更多文章';
const { Content } = await render(post);
const tags = [...new Set(post.data.tags)];
const description = post.data.description || getExcerpt(post);
const image = `/og/${post.id}.png`;
const absolute = (pathname: string) => new URL(withBase(pathname), Astro.site).href;
const url = new URL(getPostUrl(post), Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description,
  datePublished: post.data.date.toISOString(),
  inLanguage: 'zh-CN',
  url,
  mainEntityOfPage: url,
  image: absolute(image),
  author: { '@type': 'Person', name: AUTHOR_NAME, url: absolute('/about/') },
  ...(tags.length > 0 && { keywords: tags.join(', ') }),
};
---

<BaseLayout
  title={post.data.title}
  description={description}
  type="article"
  publishedTime={post.data.date}
  image={image}
  jsonLd={jsonLd}
>
  <CommentsPreconnect slot="head" />
  <article class="post" data-pagefind-body>
    <header class="post-header">
      <h1 data-pagefind-meta="title">{post.data.title}</h1>
      {tags.length > 0 && <TagList tags={tags} pills />}
      <p class="post-kicker" data-pagefind-ignore>
        <time class="post-date" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span class="post-kicker-rest">
          <span class="post-kicker-sep" aria-hidden="true"> · </span>
          <span>{getReadingMinutes(post)} 分钟阅读</span>
          <ViewCount slug={post.id} />
        </span>
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>

  <footer class="post-footer">
    {
      backlinks.length > 0 && (
        <section class="post-section" aria-labelledby="backlinks-title">
          <h2 class="section-title" id="backlinks-title">提到这篇的文章</h2>
          <ol class="post-rows">
            {backlinks.map((item) => (
              <PostRow post={item} />
            ))}
          </ol>
        </section>
      )
    }

    {
      more.length > 0 && (
        <section class="post-section" aria-labelledby="related-title">
          <h2 class="section-title" id="related-title">{moreTitle}</h2>
          <ol class="post-rows">
            {more.map((item) => (
              <PostRow post={item} />
            ))}
          </ol>
        </section>
      )
    }

    <Comments term={post.id} />
  </footer>
</BaseLayout>
