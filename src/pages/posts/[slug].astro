---
import { render } from 'astro:content';
import Comments from '../../components/Comments.astro';
import CommentsPreconnect from '../../components/CommentsPreconnect.astro';
import PostRow from '../../components/PostRow.astro';
import TagList from '../../components/TagList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AUTHOR_NAME } from '../../consts';
import { withBase } from '../../utils/paths';
import {
  formatDate,
  getBacklinks,
  getExcerpt,
  getPostUrl,
  getPublishedPosts,
  type Post,
} from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const backlinks = getBacklinks(posts);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      backlinks: backlinks.get(post.id) ?? [],
    },
  }));
}

interface Props {
  post: Post;
  backlinks: Post[];
}

const { post, backlinks } = Astro.props;
const { Content } = await render(post);
const tags = [...new Set(post.data.tags)];
const description = post.data.description || getExcerpt(post);
const image = `/og/${post.id}.png`;
const absolute = (pathname: string) => new URL(withBase(pathname), Astro.site).href;
const url = new URL(getPostUrl(post), Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description,
  datePublished: post.data.date.toISOString(),
  inLanguage: 'zh-CN',
  url,
  mainEntityOfPage: url,
  image: absolute(image),
  author: { '@type': 'Person', name: AUTHOR_NAME, url: absolute('/about/') },
  ...(tags.length > 0 && { keywords: tags.join(', ') }),
};
---

<BaseLayout
  title={post.data.title}
  description={description}
  type="article"
  publishedTime={post.data.date}
  image={image}
  jsonLd={jsonLd}
>
  <CommentsPreconnect slot="head" />
  <article class="post" data-pagefind-body>
    <header class="post-header">
      <h1 data-pagefind-meta="title">{post.data.title}</h1>
      {tags.length > 0 && <TagList tags={tags} pills />}
      <p class="post-kicker" data-pagefind-ignore>
        <time class="post-date" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>

  <footer class="post-footer">
    {
      backlinks.length > 0 && (
        <section class="post-section" aria-labelledby="backlinks-title">
          <h2 class="section-title" id="backlinks-title">提到这篇的文章</h2>
          <ol class="post-rows">
            {backlinks.map((item) => (
              <PostRow post={item} />
            ))}
          </ol>
        </section>
      )
    }

    <Comments term={post.id} />
  </footer>
</BaseLayout>
