---
interface Props {
  title: string;
  description?: string;
  /** 标题背后加一层灰色记号，用在标签页。 */
  mark?: boolean;
}

const { title, description, mark = false } = Astro.props;
---

<header class="page-heading">
  <h1 class:list={{ 'heading-mark': mark }}>{title}</h1>
  {description && <p class="page-description">{description}</p>}
  <slot />
</header>
