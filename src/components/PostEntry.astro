---
import type { Post } from '../utils/posts';
import { formatDate, getPostUrl, getReadingMinutes } from '../utils/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<li class="post-entry">
  <a class="post-entry-link" href={getPostUrl(post)}>
    <h2 class="post-entry-title">{post.data.title}</h2>
    <p class="post-info">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>{' '}
      <span aria-hidden="true">·</span>{' '}
      <span>{getReadingMinutes(post)} 分钟阅读</span>
    </p>
  </a>
</li>
